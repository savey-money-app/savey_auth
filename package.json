    "setup": "bun run scripts/setup-schema.ts && bun run scripts/migrate-users.ts"
  },
  "dependencies": {
    "better-auth": "^1.2.7",
    "hono": "^4.7.7",
    "pg": "^8.14.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.2.14",
    "@types/pg": "^8.11.14",
    "drizzle-kit": "^0.31.1",
    "typescript": "^5.8.3"
  }
}
