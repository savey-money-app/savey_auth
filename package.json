{
  "name": "savey_auth",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "lint": "biome lint src scripts drizzle.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "setup-schema": "bun run scripts/setup-schema.ts",
